config {
  type: "table",
  schema: "core",
  name: "currency_totalsales_brpr",
  description: "Total revenue per currency, branch, and product"
}

SELECT
    currency,
    branch,
    product_id,
    ROUND(SUM(total_price), 2) AS total_revenue,
    #CURRENT_DATE() AS snapshot_date
FROM ${ref({schema:"staging" ,name:"stg_pubsub_sales"})}
GROUP BY
    currency, branch, product_id